
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(daysToKeepStr: '2'))
    }

    environment {
        GIT_URL = 'https://github.com/shivashankarbukka402/Sagar.git'
        GIT_BRANCH = 'main'
        GIT_CREDENTIALS = 'shivashankarbukka402'
        IMAGE_NAME = 'shiva9828/kee'
        IMAGE_TAG = "v1-${BUILD_NUMBER}"
        DOCKERFILE_BASE = 'Dockerfile'
        DOCKER_REGISTRY_CRED_ID = 'shiva9828'
        SONAR_HOST_URL = 'http://13.200.229.244:9000'
    }

    stages {
        stage('CHECKOUT') {
            steps {
                script {
                    gitcheckout(
                        env.GIT_URL,
                        env.GIT_BRANCH,
                        env.GIT_CREDENTIALS
                    )
                }
            }
        }

        stage('Sonar Code Quality check') {
            steps {
                dir('Backend') {
                    withCredentials([
                        string(
                            credentialsId: 'SONAR_TOKEN',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x
                            /opt/sonar-scanner/sonar-scanner/bin/sonar-scanner \
                              -Dsonar.projectKey=kee \
                              -Dsonar.sources=. \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Docker Build and Push') {
            steps {
                script {
                    sh 'ls -lrt'

                    dir('Backend') {
                        def dockerImage = docker.build(
                            "${IMAGE_NAME}:${IMAGE_TAG}",
                            "-f ${DOCKERFILE_BASE} ."
                        )

                        docker.withRegistry(
                            '',
                            "${DOCKER_REGISTRY_CRED_ID}"
                        ) {
                            dockerImage.push()
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
